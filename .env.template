# Environment variables for smart-home-state deployment on Raspberry Pi 3B+
# Copy this file to .env and customize the values

# Watchtower follows both services' stable tags after a release is published.
# Set to a specific release tag (e.g. v0.25.0) to pin or roll back both services.
SHS_VERSION=stable

NOTIFICATION_EMAIL_URL=smtp://user@example.com:secret@smtp.example.com:587/?fromaddress=sender@example.com&toaddresses=recipient@example.com&encryption=ExplicitTLS&usestarttls=yes
NOTIFICATION_EMAIL_SUBJECT_TAG=[Smart Home]
#where to find the docker socket for watchtower to restart containers. 
#If a rootful docker is installed, it is the default value written here. 
#Otherwise, run ls -l "$XDG_RUNTIME_DIR" on the host to get it"
DOCKER_SOCKET_LOCATION=/var/run/ 

# Java runtime options (optimized for Raspberry Pi 3B+ with 1GB RAM)
JAVA_OPTS=-Xmx256m -Xms128m -XX:+UseG1GC -XX:+UseContainerSupport

TIMEZONE=Europe/Madrid

# MQTT Configuration
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_CLIENT_ID=smart-home-state
MQTT_TRACE_MESSAGES=false

# OpenHAB Configuration
OPENHAB_HOST=localhost
OPENHAB_PORT=8080
OPENHAB_API_TOKEN=your_openhab_api_token_here

# Application Configuration
STATE_PERSISTENCE_PATH=/app/data/state.json
STATE_PERSISTENCE_INTERVAL=10 seconds

# Security Note: Keep this .env file secure and never commit it to version control
